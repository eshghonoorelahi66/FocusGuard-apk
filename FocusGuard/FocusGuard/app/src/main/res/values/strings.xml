    <string name="a11y_disc_title">About the Accessibility permission</string>
    <string name="a11y_disc_body">Focus Guard uses Android\'s Accessibility service only to learn which app just opened, so it can show the lock screen for apps you chose. It does not read what is on your screen, does not record anything and does not send any data anywhere. Everything stays on your phone.</string>
    <string name="p_a11y">Instant blocking (Accessibility)</string>
    <string name="p_a11y_d">Recommended. Blocks the moment an app opens, with zero battery polling.</string>
    <string name="p_usage">Usage access</string>
    <string name="p_usage_d">Needed for per-app time reports and the backup blocking method.</string>
    <string name="p_overlay">Display over other apps</string>
    <string name="p_overlay_d">Lets the lock screen appear on top of a blocked app.</string>
    <string name="p_notif">Notifications</string>
    <string name="p_notif_d">Shows the running timer and the session summary.</string>
    <string name="p_exact">Exact alarms</string>
    <string name="p_exact_d">Optional. Starts planned sessions exactly on time.</string>
    <string name="p_battery">Battery optimization</string>
    <string name="p_battery_d">Optional. Stops some phones from killing the timer.</string>
